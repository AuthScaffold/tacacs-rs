{
    "name": "tacacs-rs Linux development",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "CARGO_BUILD_JOBS": "1",
        "CARGO_PROFILE_TEST_DEBUG": "0",
        "CARGO_TARGET_DIR": "${containerWorkspaceFolder}/target"
    },
    "mounts": [
        "source=tacacs-rs-cargo-registry,target=/usr/local/cargo/registry,type=volume",
        "source=tacacs-rs-cargo-git,target=/usr/local/cargo/git,type=volume",
        "source=tacacs-rs-target,target=${containerWorkspaceFolder}/target,type=volume"
    ],
    "postCreateCommand": "sudo chown -R vscode:vscode /usr/local/cargo \"${containerWorkspaceFolder}/target\" && cargo fetch --locked",
    "customizations": {
        "vscode": {
            "extensions": [
                "github.copilot",
                "github.copilot-chat",
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "vadimcn.vscode-lldb"
            ],
            "settings": {
                "rust-analyzer.cargo.allFeatures": true,
                "rust-analyzer.check.command": "clippy"
            }
        }
    }
}
