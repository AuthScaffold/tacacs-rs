[Unit]
Description=Local TACACS+ client service for SONiC
Documentation=https://github.com/AuthScaffold/tacacs-rs
# SONiC stores configuration in Redis CONFIG_DB.
# The ordering usually prevents an initial retry.
# The daemon also tolerates database starts and restarts.
After=database.service network-online.target
Wants=database.service network-online.target

[Service]
# The unit stays in "activating" until SONiC supplies the first TACACS+ server.
# The daemon sends READY=1 after it receives the initial configuration.
Type=notify
NotifyAccess=all
ExecStart=/usr/sbin/tacacsrs-agentd \
    --sonic \
    --listen-endpoint /run/tacacs/tacacs.sock \
    --socket-mode 666 \
    --host-integration systemd \
    -vv

# Recreate the Unix domain socket after a restart. Remove it after a stop.
Restart=on-failure
RestartSec=2s
RuntimeDirectory=tacacs
RuntimeDirectoryMode=0755
TimeoutStartSec=0
TimeoutStopSec=15s

# Hot reload requires Redis keyspace notifications.
# The agent retries subscription setup after an error.
# If a notification stream ends, the agent reloads the configuration before it subscribes again.
#   redis-cli -n 4 CONFIG SET notify-keyspace-events KEA

# These hardening defaults support the privileged SONiC service model.
# If the image supports stricter values, use them.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/tacacs /var/run/redis

[Install]
WantedBy=multi-user.target
