#!/bin/sh
set -e

CONFIG_FILE=/etc/tacacsrs-agentd/config.ini
SERVICE_NAME=tacacsrs-agentd.service

update_config_value() {
    key="$1"
    value="$2"

    if [ ! -f "$CONFIG_FILE" ]; then
        install -d -m 0755 /etc/tacacsrs-agentd
        touch "$CONFIG_FILE"
    fi

    if grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG_FILE"; then
        sed -i "s|^[[:space:]]*${key}[[:space:]]*=.*$|${key}=${value}|" "$CONFIG_FILE"
    else
        printf '%s=%s\n' "$key" "$value" >> "$CONFIG_FILE"
    fi
}

configure_service_state() {
    enabled="$1"

    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi

    if [ "$enabled" = "true" ]; then
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper enable "$SERVICE_NAME" >/dev/null || true
        fi
        if command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke start "$SERVICE_NAME" >/dev/null || true
        fi
    else
        if command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke stop "$SERVICE_NAME" >/dev/null || true
        fi
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper disable "$SERVICE_NAME" >/dev/null || true
        fi
    fi
}

case "$1" in
    configure)
        . /usr/share/debconf/confmodule

        db_get tacacsrs-agentd/config-source || true
        config_source="$RET"
        db_get tacacsrs-agentd/install-sonic-service || true
        install_service="$RET"

        update_config_value config_source "$config_source"
        if [ "$install_service" = "true" ]; then
            update_config_value install_sonic_systemd_service yes
        else
            update_config_value install_sonic_systemd_service no
        fi

        configure_service_state "$install_service"

        db_stop || true
        ;;
esac

exit 0