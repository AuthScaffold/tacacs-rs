# This file keeps the Docker build context small and reproducible.
# It applies when the workspace root is the build context (see containers/*/Dockerfile).
#
# By default, this file denies all paths. It sends only the necessary Cargo
# workspace metadata and crate build inputs to the Docker daemon.
# This rule excludes local generated files, release artifacts, notes,
# documentation, and unrelated worktree data from the container build context.

**

# Include the workspace build metadata.
!Cargo.toml
!Cargo.lock
!.cargo/
!.cargo/config.toml

# Include the workspace crate directories.
# Include each parent directory before you include its selected child directories.
!libraries/
!executables/
!libraries/*/
!executables/*/

# After you include the parent directories, ignore the crate contents again.
# The rules below include the necessary build inputs.
libraries/*/**
executables/*/**

# Include the Cargo package metadata and build scripts.
!libraries/*/Cargo.toml
!executables/*/Cargo.toml
!libraries/*/build.rs
!executables/*/build.rs
!libraries/*/README.md
!executables/*/README.md
!libraries/*/readme.md
!executables/*/readme.md

# Include the Rust sources and generated-code inputs for the build.
!libraries/*/src/
!libraries/*/src/**
!executables/*/src/
!executables/*/src/**
!libraries/*/proto/
!libraries/*/proto/**
!executables/*/proto/
!executables/*/proto/**

# Include the inputs that tacacsrs-config uses to generate YANG and configuration files.
!libraries/tacacsrs_config/yang/
!libraries/tacacsrs_config/yang/**

# Include the TLS fixtures for tacacsrs-agentd tests.
!libraries/tacacsrs_networking/examples/
!libraries/tacacsrs_networking/examples/samples/
!libraries/tacacsrs_networking/examples/samples/**
!lde/
!lde/containers/
!lde/containers/config/
!lde/containers/config/certificates/
!lde/containers/config/certificates/client.*
