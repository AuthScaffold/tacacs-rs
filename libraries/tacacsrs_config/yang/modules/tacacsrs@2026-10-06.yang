module tacacsrs {
  yang-version 1.1;
  namespace "urn:authscaffold:tacacs-rs:yang:tacacsrs";
  prefix trs;

  import ietf-system {
    prefix sys;
    reference
      "RFC 7317: A YANG Data Model for System Management";
  }

  import ietf-system-tacacs-plus {
    prefix sys-tcs-plus;
    reference
      "RFC 9950: A YANG Data Model for Terminal Access Controller
                 Access-Control System Plus (TACACS+)";
  }

  organization
    "AuthScaffold tacacs-rs project";
  contact
    "Project Web: <https://github.com/AuthScaffold/tacacs-rs>";
  description
    "Project-owned TACACS+ configuration extensions for tacacs-rs.";

  revision 2026-10-06 {
    description
      "Adds local service listeners, failover, and request-admission policy.";
  }

  revision 2026-05-20 {
    description
      "Adds TLS 1.3 PSK psk_dhe_ke supported group configuration.";
    reference
      "RFC 8446: The Transport Layer Security (TLS) Protocol
                 Version 1.3, Sections 4.2.7 and 4.2.8";
  }

  feature psk-dhe-ke-hello-params {
    description
      "Indicates that TLS 1.3 PSK psk_dhe_ke ClientHello supported
       group and key share parameters are configurable.";
  }

  typedef failover-strategy {
    type enumeration {
      enum deferred-failover {
        description
          "Record a failed attempt and let the next request select the next server.";
      }
      enum ordered-safe-retry {
        description
          "Try the next eligible server during the current request when replay is safe.";
      }
    }
    description
      "Failover behavior for a local TACACS+ service.";
  }

  typedef proxy-credential-source {
    type enumeration {
      enum unobfuscated {
        description "Require unobfuscated downstream packets.";
      }
      enum inline {
        description "Use the configured proxy shared secret.";
      }
      enum local-proxy-row {
        description
          "Use the highest-priority upstream row matching the local proxy endpoint.
           A missing row or missing secret rejects the candidate configuration.";
      }
    }
    description "Authoritative source of downstream proxy obfuscation credentials.";
  }

  grouping request-limits {
    description
      "Admission and execution limits shared by all callers of one operation.";
    leaf request-timeout-seconds {
      type uint32 { range "1..max"; }
      units "seconds";
      default 30;
      description
        "Total request budget from capture before admission through completion.
         Includes admission, connection setup, retries, and proxy continuations.
         Server timeouts can shorten individual stages but cannot extend this budget.
         Reload does not change the deadline of an existing request.";
    }
    leaf max-body-length {
      type uint32 { range "1..65536"; }
      units "bytes";
      default 16384;
      description
        "Maximum encoded TACACS+ request body length.";
    }
    leaf max-concurrent-requests {
      type uint32 { range "1..max"; }
      default 64;
      description
        "Maximum concurrent requests for one operation.";
    }
  }

  augment "/sys:system" {
    description
      "Local TACACS+ service policy, separate from the ordered upstream server list.";
    container local-services {
      description
        "Startup listener configuration. Changes require a service restart.";
      leaf max-connections {
        type uint16 { range "1..max"; }
        default 64;
        description "Maximum served connections per enabled listener.";
      }
      leaf max-client-api-streams {
        type uint16 { range "1..max"; }
        default 64;
        description "Maximum concurrent HTTP/2 streams on one client API connection.";
      }
      leaf connection-lifetime-seconds {
        type uint32 { range "1..max"; }
        units "seconds";
        default 300;
        description
          "Maximum lifetime of a served local connection, including setup and reply delivery.
           The listener closes the connection at expiry, even when requests remain active.";
      }
      must "client-api-enabled = 'true' or tacacs-proxy-enabled = 'true'";
      must "(tacacs-proxy-enabled = 'true' and tacacs-proxy-endpoint) or
            (tacacs-proxy-enabled = 'false' and not(tacacs-proxy-endpoint))";
      must "tacacs-proxy-enabled = 'true' or proxy-credential-source = 'unobfuscated'";
      must "(proxy-credential-source = 'inline' and proxy-shared-secret) or
        (proxy-credential-source != 'inline' and not(proxy-shared-secret))";
      leaf client-api-enabled {
        type boolean;
        default true;
        description
          "Enables the local client API.";
      }
      leaf client-api-endpoint {
        type string { length "1..107"; }
        default "/run/tacacs/tacacs.sock";
        description
          "Absolute Unix socket path for the client API.";
      }
      leaf tacacs-proxy-enabled {
        type boolean;
        default false;
        description
          "Enables the raw TACACS+ proxy.";
      }
      leaf tacacs-proxy-endpoint {
        type string { length "1..max"; }
        description
          "Absolute Unix socket path or numeric IP socket address for the proxy.
           IPv6 addresses use brackets. TCP port zero requests an ephemeral port.";
      }
      leaf unix-socket-mode {
        type uint16 { range "0..511"; }
        default 432;
        description
          "Unix socket permission bits as a decimal integer. The default is octal 660.";
      }
      leaf proxy-credential-source {
        type proxy-credential-source;
        default unobfuscated;
        description "Selects downstream credentials independently of loop prevention.";
      }
      leaf proxy-shared-secret {
        type string { length "1..max"; }
        description "Downstream shared secret for the inline credential source.";
      }
    }
    container runtime-policy {
      description
        "Failover and admission controls for local client API and proxy services.";
      leaf shutdown-timeout-seconds {
        type uint32 { range "1..max"; }
        units "seconds";
        default 30;
        description
          "Graceful shutdown budget for runtime and host cleanup.
           The host captures one deadline when shutdown starts.
           At expiry, pending asynchronous work is cancelled.
           Policy updates do not extend a shutdown already in progress.";
      }
      leaf failover-recovery-interval-seconds {
        type uint32 { range "1..max"; }
        units "seconds";
        default 30;
        description
          "Interval before a failed route receives one recovery trial.";
      }
      leaf client-api-failover-strategy {
        type failover-strategy;
        default deferred-failover;
        description
          "Failover policy for requests received through the local client API.";
      }
      leaf tacacs-proxy-failover-strategy {
        type failover-strategy;
        default deferred-failover;
        description
          "Failover policy for initial requests received through the TACACS+ proxy.";
      }
      container authentication {
        description
          "Shared authentication admission limits.";
        uses request-limits {
          refine max-body-length { default 4096; }
        }
      }
      container authorization {
        description
          "Shared authorization admission limits.";
        uses request-limits;
      }
      container accounting {
        description
          "Shared accounting admission limits.";
        uses request-limits;
      }
    }
  }

  typedef psk-dhe-ke-supported-group {
    type enumeration {
      enum x25519 {
        description
          "X25519 elliptic curve group.";
        reference
          "RFC 8446: The Transport Layer Security (TLS) Protocol
                     Version 1.3, Section 4.2.7";
      }
      enum secp256r1 {
        description
          "NIST P-256 elliptic curve group.";
      }
      enum secp384r1 {
        description
          "NIST P-384 elliptic curve group.";
      }
      enum secp521r1 {
        description
          "NIST P-521 elliptic curve group.";
      }
      enum ffdhe2048 {
        description
          "Finite field Diffie-Hellman group ffdhe2048.";
        reference
          "RFC 7919: Negotiated Finite Field Diffie-Hellman Ephemeral
                     Parameters for TLS";
      }
      enum ffdhe3072 {
        description
          "Finite field Diffie-Hellman group ffdhe3072.";
      }
      enum ffdhe4096 {
        description
          "Finite field Diffie-Hellman group ffdhe4096.";
      }
      enum ffdhe6144 {
        description
          "Finite field Diffie-Hellman group ffdhe6144.";
      }
      enum ffdhe8192 {
        description
          "Finite field Diffie-Hellman group ffdhe8192.";
      }
    }
    description
      "TLS 1.3 supported groups that tacacs-rs may use for
       psk_dhe_ke ClientHello key share generation.";
    reference
      "RFC 8446: The Transport Layer Security (TLS) Protocol
                 Version 1.3, Section 4.2.7";
  }

  grouping psk-dhe-ke-hello-params {
    description
      "Configuration for TLS 1.3 PSK psk_dhe_ke ClientHello
       supported group and key share parameters.";

    leaf-list psk-dhe-ke-groups {
      if-feature "psk-dhe-ke-hello-params";
      type psk-dhe-ke-supported-group;
      ordered-by user;
      description
        "Supported groups to offer, in preference order, in
         ClientHello key_share when using TLS 1.3 PSK psk_dhe_ke.";
      reference
        "RFC 8446: The Transport Layer Security (TLS) Protocol
                   Version 1.3, Sections 4.2.7 and 4.2.8";
    }
  }

  augment "/sys:system/sys-tcs-plus:tacacs-plus/"
        + "sys-tcs-plus:client-credentials/"
        + "sys-tcs-plus:auth-type/"
        + "sys-tcs-plus:tls13-epsk/"
        + "sys-tcs-plus:tls13-epsk" {
    if-feature "psk-dhe-ke-hello-params";
    description
      "Adds PSK DHE supported group configuration to reusable client
       credential bundles.";
    uses psk-dhe-ke-hello-params;
  }

  augment "/sys:system/sys-tcs-plus:tacacs-plus/"
        + "sys-tcs-plus:server/"
        + "sys-tcs-plus:security/"
        + "sys-tcs-plus:tls/"
        + "sys-tcs-plus:client-identity/"
        + "sys-tcs-plus:ref-or-explicit/"
        + "sys-tcs-plus:explicit/"
        + "sys-tcs-plus:auth-type/"
        + "sys-tcs-plus:tls13-epsk/"
        + "sys-tcs-plus:tls13-epsk" {
    if-feature "psk-dhe-ke-hello-params";
    description
      "Adds PSK DHE supported group configuration to per-server TLS
       client identities.";
    uses psk-dhe-ke-hello-params;
  }
}
