[req]
default_bits       = 2048
distinguished_name = req_distinguished_name
req_extensions     = req_ext
prompt             = no

[req_distinguished_name]
C  = AU
ST = Queensland
L  = Brisbane
O  = AuthScaffold
OU = DevelopmentServer
CN = server.tacacsserver.local

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = server.tacacsserver.local